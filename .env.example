# ============================================================
# Vehicle Entry & Exit Analytics System — Configuration
# ============================================================
# Copy this file to .env and update values before running.
# No source code changes should be required to execute.
# ============================================================

# === Input Configuration ===
VIDEO_SOURCE=test/sample_gate_video.mp4     # Video file path or directory
CAMERA_ID=camera_1                          # Camera identifier for logs

# === Model Configuration ===
VEHICLE_MODEL=yolo11n.pt                    # YOLO11 model (auto-downloads)
PLATE_MODEL=                                # License plate YOLO model (leave empty to use PaddleOCR detection)
OCR_LANG=en                                 # PaddleOCR language
DEVICE=cpu                                  # cpu or cuda:0

# === Line Configuration ===
LINE_MODE=two_lines                         # "two_lines" or "single_line_direction"
INTERACTIVE_LINE_DRAW=false                 # true = draw with mouse, false = use coords below

# Two-line mode: coordinates as x1,y1,x2,y2
ENTRY_LINE=550,50,550,700
EXIT_LINE=400,50,400,700

# Single-line mode
SINGLE_LINE=480,50,480,700
ENTRY_DIRECTION=right_to_left               # or "left_to_right"

# === Output Configuration ===
OUTPUT_DIR=output_data
SAVE_ANNOTATED_VIDEO=true
SAVE_JSON_LOG=true
SAVE_CSV_REPORT=true
GENERATE_AI_REPORT=true

# === LLM Configuration ===
LLM_PROVIDER=gemini                         # gemini or openai
LLM_API_KEY=your_api_key_here
LLM_MODEL=gemini-2.0-flash

# === Processing Configuration ===
CONFIDENCE_THRESHOLD=0.4
PLATE_CONFIDENCE_THRESHOLD=0.3
OCR_CONFIDENCE_THRESHOLD=0.5
TRACKER_TYPE=botsort                        # botsort or bytetrack
FRAME_SKIP=2                                # Process every Nth frame (1 = all frames)

# === Web Server ===
HOST=0.0.0.0
PORT=8000
